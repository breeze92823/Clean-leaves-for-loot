# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false
# Show the Bloxbux (gem) buy buttons in the Upgrades window.
VITE_BUY_WITH_BLOXBUX=false
# Starting cash (default 0).
VITE_START_CASH=0
# Colyseus server URL (Clean-leaves-for-loot-backend). Local dev defaults to ws://localhost:2567;
# set it for deployed builds. Leave empty to play offline (no saving, no other players).
VITE_SERVER_URL=
